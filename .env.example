# Copy this file to `.env` and adjust the values for your environment.
# `.env` is gitignored and must never be committed.

LOGIN_DB_HOST=localhost
LOGIN_DB_PORT=20011
LOGIN_DB_NAME=openmmo_login_db
LOGIN_DB_USER=openmmo_login_user
LOGIN_DB_PASSWORD=changeMe!
LOGIN_DB_SEED_DEV=true

GAME_DB_HOST=localhost
GAME_DB_PORT=20021
GAME_DB_NAME=openmmo_game_db
GAME_DB_USER=openmmo_game_user
GAME_DB_PASSWORD=changeMe!
GAME_DB_SEED_DEV=true

OPENMMO_SESSION_SECRET=

# Private key shared by the login and game servers. Local builds generate one, so
# leave these empty for development. Released archives ship no key, so a
# deployment must set exactly one of them. Both servers need the same key.
# Either the PEM itself:
OPENMMO_GAME_PRIVATE_KEY=
# or a path to a PEM file:
OPENMMO_GAME_PRIVATE_KEY_FILE=