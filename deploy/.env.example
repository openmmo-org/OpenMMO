# Copy to `.env` next to this file and replace every value. Both stacks need the same
# session secret and the same private key, and the key file has to be readable by uid 10001.
#
#   docker compose --env-file .env -f game.compose.yml up -d
#   docker compose --env-file .env -f login.compose.yml up -d

# The head of the default branch, rebuilt on every push and not gated on the test suite.
OPENMMO_LOGIN_IMAGE=ghcr.io/openmmo-org/openmmo-login:dev
OPENMMO_GAME_IMAGE=ghcr.io/openmmo-org/openmmo-game:dev
# Swap for the last release, or a sha- tag to pin a build that stops moving:
#OPENMMO_LOGIN_IMAGE=ghcr.io/openmmo-org/openmmo-login:latest
#OPENMMO_GAME_IMAGE=ghcr.io/openmmo-org/openmmo-game:latest

OPENMMO_SESSION_SECRET=replace-with-a-long-random-value
OPENMMO_GAME_PRIVATE_KEY_PATH=/srv/openmmo/game.private.pem

# Created on first start, and only while the user table is still empty. Changing either later
# does nothing, so treat this as bootstrap rather than as a way to reset a password.
OPENMMO_ADMIN_USERNAME=admin
OPENMMO_ADMIN_PASSWORD=replace-with-a-random-password

# The address the login server hands to clients, so it has to be the public one.
GAME_SERVER_PUBLIC_IPV4=203.0.113.10
# Leave alone without public IPv6. A v4-only host has nothing useful to put here.
#GAME_SERVER_PUBLIC_IPV6=2001:db8::1
GAME_SERVER_PORT=7777

LOGIN_DB_NAME=openmmo_login_db
LOGIN_DB_USER=openmmo_login_user
LOGIN_DB_PASSWORD=replace-with-a-random-password

GAME_DB_NAME=openmmo_game_db
GAME_DB_USER=openmmo_game_user
GAME_DB_PASSWORD=replace-with-another-random-password
